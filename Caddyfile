# Caddyfile for Railway deployment
# This handles both HTTP/HTTPS and WebSocket connections

# Railway uses PORT environment variable, but Caddy listens on :80 by default
# Railway will handle port mapping, so we listen on :80
:80 {
    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # Reverse proxy for API requests
    handle_path /api/* {
        # Use Railway's internal service discovery - replace "backend" with your actual backend service name
        # Railway services communicate using service names (e.g., if backend service is named "backend", use "http://backend:PORT")
        # You can also use Railway's private networking - set BACKEND_URL env var and this will be resolved at runtime
        # handle_path automatically strips /api prefix before proxying
        reverse_proxy http://backend:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # WebSocket proxy for Socket.IO (CRITICAL)
    handle /socket.io/* {
        reverse_proxy http://backend:4000 {
            # WebSocket upgrade headers
            header_up Connection "upgrade"
            header_up Upgrade "websocket"
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend static files
    handle {
        root * /app/dist
        try_files {path} /index.html
        file_server
    }
}

